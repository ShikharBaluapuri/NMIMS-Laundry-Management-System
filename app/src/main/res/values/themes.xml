<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Using Bridge theme ensures standard android:background on Buttons is NOT overwritten by MaterialButton tinting -->
    <style name="Theme.LaundryManagementSystem" parent="Theme.MaterialComponents.Light.DarkActionBar.Bridge">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>

        <!-- Status bar and window background -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/background_light</item>
    </style>
</resources>